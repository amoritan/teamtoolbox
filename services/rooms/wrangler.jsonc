{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "minify": true,
  "workers_dev": false,
  "routes": [{ "pattern": "rooms.teamtoolbox.org", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // New connections per IP per minute. Counted in memory by Cloudflare, nothing stored.
  "ratelimits": [
    { "name": "CONNECT_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // Extra origin host suffixes allowed besides <tool>.teamtoolbox.org. Empty in production.
    "ALLOWED_HOST_SUFFIXES": ""
  },
  // No request logs: we don't keep IPs or room IDs.
  "observability": { "enabled": false },
  "send_metrics": false,
  "env": {
    "staging": {
      "workers_dev": true,
      "routes": [],
      "durable_objects": {
        "bindings": [{ "name": "ROOM", "class_name": "Room" }]
      },
      "ratelimits": [
        {
          "name": "CONNECT_LIMITER",
          "namespace_id": "1002",
          "simple": { "limit": 30, "period": 60 }
        }
      ],
      "vars": {
        // Preview URLs of the tool apps live on workers.dev.
        "ALLOWED_HOST_SUFFIXES": ".workers.dev,localhost"
      }
    }
  }
}

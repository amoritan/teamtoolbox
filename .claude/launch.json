{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "home",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@teamtoolbox/home", "preview"],
      "port": 4322
    },
    {
      "name": "rooms",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@teamtoolbox/rooms",
        "exec",
        "wrangler",
        "dev",
        "--port",
        "8787",
        "--var",
        "ALLOWED_HOST_SUFFIXES:localhost,127.0.0.1",
        "--var",
        "ROOM_JURISDICTION:none"
      ],
      "port": 8787
    },
    {
      "name": "ads",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@teamtoolbox/ads",
        "exec",
        "wrangler",
        "dev",
        "--port",
        "8788",
        "--var",
        "ALLOWED_HOST_SUFFIXES:localhost,127.0.0.1"
      ],
      "port": 8788
    },
    {
      "name": "retro",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@teamtoolbox/retro", "dev"],
      "port": 5173
    },
    {
      "name": "retro-guest",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@teamtoolbox/retro", "exec", "vite", "--port", "5175"],
      "port": 5175

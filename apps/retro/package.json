{
  "name": "@teamtoolbox/retro",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build",
    "typecheck": "tsc",
    "test": "vitest run",
    "preview": "wrangler dev --port 5174",
    "deploy": "pnpm run build && wrangler deploy",
    "preview:upload": "TTB_PREVIEW=1 pnpm run build && wrangler versions upload --preview-alias pr-$PR_NUMBER"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@teamtoolbox/protocol": "workspace:*",
    "@teamtoolbox/registry": "workspace:*",
    "@teamtoolbox/room-client": "workspace:*",
    "@teamtoolbox/ui": "workspace:*",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@teamtoolbox/tsconfig": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  }
}

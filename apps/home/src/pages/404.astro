    <h1 class="mb-4 text-3xl font-semibold tracking-tight">Page not found</h1>
    <p class="mb-6 text-ink-muted">This page doesn't exist, or it has moved.</p>
    <a href="/" class="text-accent underline underline-offset-2">Back to all tools</a>
  </div>
</Base>
